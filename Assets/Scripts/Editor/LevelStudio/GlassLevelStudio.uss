.studio {
    --bg: #1f2125;
    --panel: #26282d;
    --panel-2: #2e3137;
    --line: #3a3e45;
    --text: #d9dbe0;
    --muted: #979ba3;
    --accent: #5aa9f0;
    --good: #6fd08c;
    --critical: #e5534b;
    --warning: #e0a63a;
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
}

.studio__body { flex-direction: row; flex-grow: 1; min-height: 0; min-width: 0; overflow: hidden; }
.studio__center { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; }

/* Araç çubuğu */
.toolbar { flex-direction: row; align-items: center; height: 36px; padding: 0 8px; background-color: var(--panel); border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; overflow: hidden; }
.toolbar__title { -unity-font-style: bold; font-size: 13px; flex-shrink: 0; }
.toolbar__state { margin-left: 10px; min-width: 80px; color: var(--muted); flex-shrink: 0; }
.toolbar__state--dirty { color: var(--warning); }
.toolbar__mode { margin-left: 8px; padding: 2px 8px; border-radius: 10px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); font-size: 11px; color: var(--muted); flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; }
.toolbar__mode--brush { background-color: #223549; border-color: var(--accent); color: #d8ecff; }
.toolbar__mode--erase { background-color: #452321; border-color: var(--critical); color: #ffd4d1; }
.toolbar__summary { margin-right: 8px; color: var(--muted); flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; }
.toolbar__summary--bad { color: var(--critical); -unity-font-style: bold; }
.toolbar__summary--good { color: var(--good); }
.toolbar Button { height: 24px; margin: 0 0 0 4px; padding: 0 8px; flex-shrink: 0; }
.toolbar__iconbtn { padding: 0 7px; font-size: 11px; color: var(--muted); background-color: var(--panel-2); border-width: 1px; border-color: var(--line); border-radius: 4px; }
.toolbar__iconbtn--active { color: var(--text); border-color: var(--accent); }
.toolbar .unity-toggle { margin: 0 4px 0 6px; flex-shrink: 0; }
.toolbar .unity-toggle .unity-base-field__label { min-width: 0; width: auto; margin-right: 4px; color: var(--muted); }
.toolbar__primary { background-color: var(--accent); color: #101216; -unity-font-style: bold; }

/* Sol: level listesi ve akıllı üretici */
.levels { width: 232px; min-width: 210px; flex-shrink: 0; background-color: var(--panel); border-right-width: 1px; border-color: var(--line); padding: 0; }
.left-tabs { flex-direction: row; padding: 6px 6px 4px 6px; border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; background-color: var(--panel); }
.left-tabs__btn { flex-grow: 1; flex-basis: 0; height: 26px; margin: 0 2px; border-radius: 4px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); color: var(--muted); font-size: 11px; }
.left-tabs__btn--active { background-color: var(--accent); border-color: var(--accent); color: #101216; -unity-font-style: bold; }
.left-subpanel { flex-grow: 1; min-height: 0; padding-top: 6px; }

.smart-gen { flex-grow: 1; min-height: 0; padding: 6px 8px 10px 8px; }
.smart-gen__intro { font-size: 11px; color: var(--muted); white-space: normal; margin-bottom: 6px; }
.smart-gen__section { margin: 8px 0 3px 0; font-size: 10px; -unity-font-style: bold; color: var(--muted); }
.smart-gen__card { padding: 6px 7px; margin-bottom: 5px; background-color: #21242b; border-width: 1px; border-color: var(--line); border-radius: 5px; }
.smart-gen__presets { flex-direction: row; margin-bottom: 4px; }
.smart-gen__presets Button { flex-grow: 1; flex-basis: 0; height: 22px; margin: 0 2px; padding: 0 4px; font-size: 10px; }
.smart-gen__row { flex-direction: row; align-items: center; margin: 2px 0; }
.smart-gen__label { flex-grow: 1; font-size: 11px; color: var(--text); }
.smart-gen__pct { width: 38px; -unity-text-align: middle-right; font-size: 11px; -unity-font-style: bold; color: var(--accent); flex-shrink: 0; }
.smart-gen__sub { margin-left: 6px; padding-left: 6px; border-left-width: 2px; border-color: #3a4457; margin-top: 3px; }
.smart-gen__card .unity-slider-int { margin: 1px 0 3px 0; }
.smart-gen__card .unity-slider-int .unity-base-field__label { min-width: 82px; width: 82px; font-size: 10px; color: var(--muted); }
.smart-gen__card .unity-base-field { margin: 2px 0; }
.smart-gen__card .unity-base-field__label { min-width: 82px; width: 82px; font-size: 11px; color: var(--text); }
.smart-gen__card .unity-toggle .unity-base-field__label { min-width: 145px; width: auto; flex-grow: 1; font-size: 11px; }
.smart-gen__actions { padding: 6px 8px 8px 8px; border-top-width: 1px; border-color: var(--line); background-color: var(--panel); flex-shrink: 0; }
.smart-gen__btn-primary { height: 26px; margin: 2px 0; background-color: var(--accent); color: #101216; -unity-font-style: bold; }
.smart-gen__btn { height: 24px; margin: 2px 0; }
.smart-gen__batch-row { flex-direction: row; align-items: center; margin-top: 3px; }
.smart-gen__batch-row Button { flex-grow: 1; flex-basis: 0; height: 23px; margin: 0 2px; font-size: 11px; }
.smart-gen__status { margin-top: 6px; padding: 6px; border-radius: 5px; background-color: #1f2d27; border-width: 1px; border-color: #365947; }
.smart-gen__status-text { font-size: 11px; color: var(--text); white-space: normal; }
.smart-gen__links { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.smart-gen__link { height: 20px; margin: 2px 3px 0 0; padding: 0 6px; font-size: 10px; }
.create-zone { flex-direction: row; padding: 4px 6px 6px 6px; border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.create-zone Button { flex-grow: 1; flex-basis: 0; margin: 0 3px 0 0; height: 24px; }
.level-row { flex-direction: row; align-items: center; height: 46px; padding: 0 8px; }
.level-row__number { width: 26px; font-size: 15px; -unity-font-style: bold; color: var(--muted); -unity-text-align: middle-center; flex-shrink: 0; }
.level-row__text { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 4px; }
.level-row__title { -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; }
.level-row__sub { color: var(--muted); font-size: 11px; }
.level-row__dots { flex-direction: row; margin-top: 2px; }
.level-row__dot { width: 8px; height: 8px; margin-right: 3px; border-radius: 4px; }

/* Palet (fırçalar) */
.palette { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 6px 8px; background-color: var(--panel); border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.palette__label { color: var(--muted); font-size: 11px; margin: 0 6px 0 4px; }
.palette__sep { width: 1px; height: 20px; margin: 0 8px; background-color: var(--line); }
.chip { flex-direction: row; align-items: center; height: 26px; margin: 2px 4px 2px 0; padding: 0 8px 0 6px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); border-radius: 4px; color: var(--text); }
.chip:hover { border-color: rgba(255, 255, 255, 0.4); }
.chip--active { border-color: var(--accent); border-width: 2px; background-color: #26384a; }
.chip Label { margin: 0; padding: 0; }
.swatch { width: 14px; height: 14px; margin-right: 6px; border-radius: 7px; border-width: 1px; border-color: rgba(255, 255, 255, 0.3); flex-shrink: 0; }
.shape-icon { position: relative; width: 22px; height: 16px; margin-right: 4px; flex-shrink: 0; }
.shape-icon__cell { position: absolute; width: 6px; height: 6px; background-color: var(--text); border-radius: 1px; }

/* Otomasyon ve önizleme çubuğu */
.automation { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 4px 8px; background-color: var(--panel); border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.automation Button { height: 22px; margin: 0 4px 0 0; padding: 0 10px; }
.automation__label { color: var(--muted); font-size: 11px; margin-right: 6px; }
.preview { flex-direction: row; align-items: center; padding: 6px 10px; background-color: #1c3147; border-bottom-width: 1px; border-color: var(--accent); flex-shrink: 0; }
.preview__title { -unity-font-style: bold; }
.preview__detail { white-space: normal; color: var(--text); }
.preview Button { height: 24px; }
.preview__apply { background-color: var(--accent); color: #101216; -unity-font-style: bold; }

/* Pano: cam + tepsi */
.board { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.board__content { align-items: center; padding: 18px 10px 24px 10px; }
.board__caption { color: var(--muted); font-size: 11px; margin: 10px 0 4px 0; -unity-text-align: middle-center; }
.glass { position: relative; background-color: #dfe4fb; border-width: 4px; border-color: #9e96ee; border-radius: 16px; overflow: hidden; }
.glass__guide { position: absolute; top: 0; bottom: 0; width: 1px; background-color: rgba(65, 62, 130, 0.14); }
.glass__guide--open { background-color: rgba(90, 169, 240, 0.25); width: 0; }
.glass__column { position: absolute; top: 0; bottom: 0; background-color: rgba(124, 108, 232, 0.22); }
.glass-header { flex-direction: row; align-items: center; justify-content: center; flex-wrap: wrap; margin: 6px 0 4px 0; }
.glass-header .board__caption { margin: 0 8px 0 0; }
.ball-bar { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: center; max-width: 560px; margin: 2px 0 6px 0; padding: 4px 6px; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 6px; }
.ball-bar__sep { width: 1px; height: 18px; margin: 0 5px; background-color: var(--line); }
.ball-bar__count { font-size: 11px; color: var(--muted); margin: 0 6px; }
.ball-chip { flex-direction: row; align-items: center; height: 22px; margin: 2px; padding: 0 6px 0 4px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); border-radius: 4px; font-size: 11px; color: var(--text); }
.ball-chip:hover { border-color: rgba(255, 255, 255, 0.45); }
.ball-chip--active { border-color: var(--accent); border-width: 2px; background-color: #26384a; }
.ball-chip--warn { border-color: var(--warning); }
.ball-chip .swatch { width: 12px; height: 12px; margin-right: 4px; border-radius: 6px; }
.ball { position: absolute; border-radius: 999px; border-width: 1.5px; border-color: rgba(14, 16, 40, 0.48); }
.ball--dim { opacity: 0.25; }
.ball--selected { border-color: #ffffff; border-width: 2.5px; }
.ball--hover { border-color: #5aa9f0; border-width: 2.5px; }
.ball--tube { opacity: 0.55; border-color: #3a52c4; border-width: 2px; }
.tube-row { position: absolute; left: 6px; right: 6px; top: 4px; flex-direction: row; align-items: center; justify-content: space-between; }
.tube-pill { flex-direction: row; align-items: center; padding: 2px 6px; border-radius: 6px; background-color: rgba(45, 56, 125, 0.88); }
.tube-pill__label { font-size: 10px; color: #ffffff; margin-right: 4px; }
.tube-dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 2px; border-width: 1px; border-color: rgba(14, 16, 40, 0.55); }
.gen-bar { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 4px 8px; background-color: #222936; border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.gen-bar .unity-toggle { margin: 0 8px 0 0; }
.gen-bar .unity-toggle .unity-base-field__label { min-width: 0; width: auto; margin-right: 3px; color: var(--text); font-size: 11px; }
.gen-bar Button { height: 22px; margin: 2px 4px 2px 0; padding: 0 8px; }
.ball-slot { position: absolute; border-radius: 999px; border-width: 1px; border-color: rgba(80, 86, 150, 0.34); background-color: rgba(255, 255, 255, 0.28); }
.ball-slot--hover { border-color: #5aa9f0; border-width: 2px; background-color: rgba(90, 169, 240, 0.28); }
.tray { position: relative; margin-top: 12px; padding: 0; background-color: #5b4fa4; border-radius: 14px; border-width: 4px; border-color: #b4bcf9; }
.tray__cell { position: absolute; background-color: #7064bc; border-radius: 6px; }
.tray__cell--top { border-top-width: 2px; border-color: rgba(255, 255, 255, 0.35); }
.tray-wall { position: absolute; background-color: #463c8a; border-color: #9b99dc; }
.tray-wall__inner { position: absolute; background-color: #827ae0; }
.tray-wall--ghost { opacity: 0.6; }
.block-cell { position: absolute; border-radius: 7px; border-width: 3px; border-color: rgba(0, 0, 0, 0.25); }
.block-cell__inner { position: absolute; left: 6px; right: 6px; top: 6px; bottom: 6px; background-color: #eef0f4; border-radius: 4px; }
.block-cell--ice { background-color: #56c2f6; border-color: #c2f0ff; }
.block-cell__inner--ice { background-color: #8ee2ff; }
.block-cell--locked { border-color: #ffd147; }
.block-cell--selected { border-color: white; }
.block-cell--critical { border-color: var(--critical); }
.block-cell--ghost { opacity: 0.6; }
.block-cell--invalid { border-color: var(--critical); opacity: 0.6; }
.block-label { position: absolute; -unity-text-align: middle-center; font-size: 15px; -unity-font-style: bold; color: #2a2c33; }
.block-label--ice { font-size: 17px; color: #ffffff; -unity-text-outline-width: 1.2px; -unity-text-outline-color: #0b3460; }
.block-number { position: absolute; font-size: 10px; color: #6b6e78; }
.block-badge-row { position: absolute; flex-direction: row; }
.block-badge { padding: 1px 4px; margin-right: 2px; border-radius: 4px; font-size: 9px; -unity-font-style: bold; border-width: 1px; }
.block-badge--key { background-color: #f5c231; border-color: #7c4d00; color: #2d1b00; }
.block-badge--lock { background-color: #f4a922; border-color: #703900; color: #2d1400; }
.block-badge--ice { background-color: #36b5f5; border-color: #d9f6ff; color: #ffffff; }
.block-colordot { position: absolute; width: 10px; height: 10px; border-radius: 5px; border-width: 1.5px; border-color: rgba(255, 255, 255, 0.92); }
.block-link-bridge { position: absolute; border-width: 1.5px; border-color: rgba(18, 20, 34, 0.85); border-radius: 5px; overflow: hidden; }
.block-link-bridge--h { flex-direction: row; }
.block-link-bridge--v { flex-direction: column; }
.block-link-bridge__half { flex-grow: 1; flex-basis: 0; }
.block-link-armed { border-color: #66e4ff; border-width: 3.5px; }

/* Cam sırası şeridi */
.order { flex-direction: row; flex-wrap: wrap; justify-content: center; max-width: 560px; }
.order__chip { flex-direction: row; align-items: center; height: 24px; margin: 2px; padding: 0 7px 0 4px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); border-radius: 4px; }
.order__chip:hover { border-color: rgba(255, 255, 255, 0.4); }
.order__chip--selected { border-color: var(--accent); border-width: 2px; }
.order__chip--linked { border-color: white; }
.order__index { color: var(--muted); font-size: 10px; margin-right: 4px; }

/* Sağ panel */
.studio__side { width: 274px; min-width: 248px; flex-shrink: 0; background-color: var(--panel); border-left-width: 1px; border-color: var(--line); overflow: hidden; }
.solve { margin: 8px; padding: 9px; border-radius: 6px; background-color: var(--panel-2); flex-shrink: 0; }
.solve--good { background-color: #1f3a2a; }
.solve--bad { background-color: #452321; }
.solve--unknown { background-color: #40331a; }
.solve__title { font-size: 14px; -unity-font-style: bold; }
.solve__detail { color: var(--muted); white-space: normal; margin-top: 2px; font-size: 11px; }
.solve__action { margin-top: 6px; height: 22px; background-color: var(--accent); color: #101216; -unity-font-style: bold; font-size: 11px; }
.stats { flex-direction: row; margin: 0 8px 6px 8px; flex-shrink: 0; }
.stat { flex-grow: 1; flex-basis: 0; margin-right: 5px; padding: 5px; background-color: var(--panel-2); border-radius: 5px; }
.stat__value { font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center; }
.stat__label { font-size: 10px; color: var(--muted); -unity-text-align: middle-center; }

.inspector { flex-grow: 1; padding: 4px 10px 10px 8px; min-width: 0; }
.inspector__title { font-size: 13px; -unity-font-style: bold; margin-top: 6px; }
.inspector__sub { color: var(--muted); margin-bottom: 6px; white-space: normal; font-size: 11px; }
.inspector__hint { color: var(--muted); white-space: normal; margin-top: 4px; font-size: 11px; }
.inspector__foldout { margin-top: 8px; }
.inspector__foldout > Toggle { margin-left: 0; }
.inspector__row { flex-direction: row; align-items: center; margin: 3px 0; }
.inspector__row-label { width: 78px; flex-shrink: 0; font-size: 11px; }
.inspector__row Button { width: 26px; height: 22px; margin: 0 2px; }
.inspector__count { width: 34px; -unity-text-align: middle-center; font-size: 14px; -unity-font-style: bold; }
.inspector__action { margin: 6px 0 0 0; height: 25px; }
.inspector__danger { color: #ff8f88; }
.inspector .unity-base-field { margin: 2px 0; min-width: 0; }
.inspector .unity-base-field__label { min-width: 78px; width: 78px; font-size: 11px; }
.inspector .unity-base-field__input { min-width: 0; flex-shrink: 1; }

/* Bulgular */
.issues-wrap { flex-shrink: 0; background-color: var(--panel); border-top-width: 1px; border-color: var(--line); }
.issues-header { flex-direction: row; align-items: center; height: 24px; padding: 0 8px; background-color: #212329; border-bottom-width: 1px; border-color: var(--line); }
.issues-header__title { font-size: 11px; -unity-font-style: bold; color: var(--muted); flex-grow: 1; }
.issues-header__toggle { height: 18px; padding: 0 8px; font-size: 10px; }
.issues { height: 78px; flex-shrink: 0; padding: 4px 8px; background-color: var(--panel); }
.issue { flex-direction: row; align-items: flex-start; padding: 2px 0; }
.issue:hover { background-color: var(--panel-2); }
.issue__tag { width: 52px; flex-shrink: 0; font-size: 10px; -unity-font-style: bold; }
.issue--critical .issue__tag { color: var(--critical); }
.issue--warning .issue__tag { color: var(--warning); }
.issue--info .issue__tag { color: var(--muted); }
.issue__text { white-space: normal; flex-shrink: 1; }

/* ==================== Cam Stüdyosu ==================== */
.glass-canvas { flex-grow: 1; min-height: 240px; margin: 10px; background-color: #17181b; border-radius: 8px; border-width: 1px; border-color: var(--line); }
.glass-readout { -unity-font-style: bold; color: var(--text); }
.level-row__glass { width: 18px; height: 12px; margin-left: 6px; border-radius: 4px; border-width: 3px; flex-shrink: 0; }

.inspector__section { margin: 14px 0 4px 0; font-size: 11px; -unity-font-style: bold; color: var(--muted); }
/* Katlanır bölüm: sağ panel tek uzun kaydırma olmaktan çıkar, bölümler aç/kapa edilir */
.inspector__fold { margin: 10px 0 2px 0; border-top-width: 1px; border-color: var(--line); padding-top: 6px; }
.inspector__fold > .unity-foldout__toggle { margin: 0; }
.inspector__fold > .unity-foldout__toggle .unity-text-element { font-size: 11px; -unity-font-style: bold; color: var(--muted); }
.inspector__fold > .unity-foldout__content { margin-left: 0; padding-left: 0; }
.segmented { flex-direction: row; margin-top: 2px; }
.segmented__item { flex-grow: 1; flex-basis: 0; height: 28px; margin: 0; border-radius: 0; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); color: var(--muted); }
.segmented__item--active { background-color: var(--accent); color: #101216; -unity-font-style: bold; border-color: var(--accent); }
.chip-grid { flex-direction: row; flex-wrap: wrap; }
.box-icon { margin-right: 6px; border-width: 2px; border-color: var(--text); flex-shrink: 0; }
.glass-warning { margin-top: 8px; padding: 6px 8px; background-color: #40331a; border-radius: 4px; white-space: normal; font-size: 11px; }
.inspector .unity-slider .unity-base-field__label { min-width: 70px; width: 70px; }
.inspector .unity-slider .unity-base-slider__input { min-width: 40px; }
.inspector .unity-slider .unity-float-field { width: 44px; }
